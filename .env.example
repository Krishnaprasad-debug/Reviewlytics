# GEMINI_API_KEY: Required for server-side AI Review Intelligence calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# APIFY_API_TOKEN: Required for importing real Amazon and Flipkart customer reviews via Apify.
# Obtain from https://console.apify.com/account/integrations
APIFY_API_TOKEN="your_apify_token"

# SUPABASE_URL: Required for Supabase PostgreSQL primary database persistence.
# Obtain from Supabase Dashboard -> Project Settings -> API -> Project URL
SUPABASE_URL="https://your-project-ref.supabase.co"

# SUPABASE_SERVICE_ROLE_KEY: Server-side privileged secret key for Express backend to access Supabase PostgreSQL.
# Obtain from Supabase Dashboard -> Project Settings -> API -> Project API keys -> service_role (secret)
# NEVER expose this key in frontend code or VITE_ variables.
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key"

# JWT_SECRET: Secret for signing JWT authentication tokens.
JWT_SECRET="your_jwt_secret_key"
